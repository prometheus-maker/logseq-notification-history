{
  "name": "logseq-notification-history",
  "version": "1.0.0",
  "description": "Keeps every pop-up message Logseq and its plugins show, so you can read one after it disappears.",
  "main": "dist/index.html",
  "author": "prometheus-maker",
  "license": "MIT",
  "type": "module",
  "logseq": {
    "id": "notification-history",
    "title": "Notification History",
    "icon": "./icon.png",
